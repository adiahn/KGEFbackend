PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/kasedaloan
# Comma-separated list of allowed origins for CORS (one per frontend domain,
# e.g. the Vercel URL plus any custom domain like https://kgef.example.com).
CLIENT_ORIGIN=http://localhost:5173

# SMTP, used to email applicants their tracking number on submission.
# Confirmation emails are silently skipped if these are unset.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Used to sign application-tracking session tokens. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cloudinary — stores uploaded applicant documents. Uploads are silently
# skipped (submission still succeeds) if these are unset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Shared password for the admin dashboard. Change this to something you choose.
ADMIN_PASSWORD=
