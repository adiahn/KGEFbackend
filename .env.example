PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/kasedaloan
# Public frontend URL(s). First entry is used in applicant emails (e.g. the
# missing CAC Status Report notice) as the link back to “Track Your Application”.
# Also historically documented as a CORS allowlist; the API currently accepts
# any origin because auth is Bearer-token based, not cookie based.
CLIENT_ORIGIN=http://localhost:5173

# SMTP, used for OTP / confirmation / document-request emails.
# Confirmation emails are silently skipped if these are unset.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Visible From address (e.g. the mailbox configured on Vercel). Falls back to SMTP_USER.
SMTP_FROM=

# Used to sign application-tracking session tokens. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cloudinary — stores uploaded applicant documents. Uploads are silently
# skipped (submission still succeeds) if these are unset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Shared password for the admin dashboard. Change this to something you choose.
ADMIN_PASSWORD=
